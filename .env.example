# ================================================================
# አጸደ ትጉሃን — Ethiopian Sunday School Management System
# Environment Configuration Example
# ================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ================================================================

# ---------------------------------------------------------------
# Database Connection
# ---------------------------------------------------------------
DB_HOST=127.0.0.1
DB_USER=root
DB_PASS=
DB_NAME=atsede_sunday_school

# ---------------------------------------------------------------
# OpenSSL Configuration (required on Windows / XAMPP)
# Path to the openssl.cnf file for VAPID key generation.
# ---------------------------------------------------------------
OPENSSL_CONF=C:/xampp/apache/conf/openssl.cnf

# ---------------------------------------------------------------
# Web Push / VAPID
# Keys are auto-generated on first run and stored in the
# `settings` table. You may override them here if you have
# pre-generated keys from another source.
# Leave blank to let the system auto-generate.
# ---------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---------------------------------------------------------------
# Application Settings
# ---------------------------------------------------------------
# Base URL of the application (no trailing slash)
APP_URL=http://localhost/exam

# Session name (change in production)
SESSION_NAME=atsede_session

# ---------------------------------------------------------------
# Offline / PWA Sync
# ---------------------------------------------------------------
# Offline token expiry in seconds (default: 30 days)
OFFLINE_TOKEN_EXPIRY=2592000

# ---------------------------------------------------------------
# OCR Provider (for lesson plan photo upload)
# Options: local_tesseract | google_cloud_vision | ocr_space | fallback
# ---------------------------------------------------------------
OCR_PROVIDER=fallback

# Google Cloud Vision API Key (only if OCR_PROVIDER=google_cloud_vision)
GOOGLE_CLOUD_VISION_KEY=

# OCR.Space API Key (only if OCR_PROVIDER=ocr_space)
OCR_SPACE_KEY=

# Tesseract binary path (only if OCR_PROVIDER=local_tesseract)
TESSERACT_PATH=C:/Program Files/Tesseract-OCR/tesseract.exe

# ---------------------------------------------------------------
# Backup
# ---------------------------------------------------------------
# Directory where database backups are stored (relative to project root)
BACKUP_DIR=backups/

# ---------------------------------------------------------------
# Email / SMS Notifications (future)
# ---------------------------------------------------------------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
